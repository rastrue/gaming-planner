# Copy this file to the repo root as `.env` before running migrations or the API.
# PostgreSQL connection string (required for migrations; generate works without a live DB)
DATABASE_URL=postgresql://YOUR_LOGIN:YOUR_PASSWORD@localhost:5432/questsync

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-in-production

# SMTP for report e-mail delivery (required for "Email delivery" reports)
# Copy these into your local `.env` only — never commit real credentials to Git.
#
# Required variables for any provider:
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS
# Optional:
#   SMTP_FROM  (defaults to QuestSync <SMTP_USER> if omitted)
#
# --- Gmail (use an App Password, not your normal Gmail password) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=QuestSync <your.address@gmail.com>
#
# --- Outlook / Microsoft 365 ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=your.address@outlook.com
# SMTP_PASS=your-account-password-or-app-password
# SMTP_FROM=QuestSync <your.address@outlook.com>
#
# --- Yahoo Mail ---
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=587
# SMTP_USER=your.address@yahoo.com
# SMTP_PASS=your-app-password
# SMTP_FROM=QuestSync <your.address@yahoo.com>
#
# --- SendGrid (SMTP API) ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM=QuestSync <verified-sender@yourdomain.com>
#
# --- Mailgun ---
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-mailgun-domain
# SMTP_PASS=your-mailgun-smtp-password
# SMTP_FROM=QuestSync <noreply@your-mailgun-domain>
#
# --- Generic / custom SMTP (VPS, hosting panel, local test server) ---
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=QuestSync <sender@example.com>
# Use port 465 with most providers if 587 is blocked; the server sets `secure` automatically for 465.
